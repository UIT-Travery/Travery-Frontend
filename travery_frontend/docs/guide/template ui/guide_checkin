<!DOCTYPE html>

<html lang="vi"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Travery - Điểm danh</title>
<!-- Tailwind CSS v3 CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'travery-blue': '#007bff',
            'status-present': '#28a745',
            'status-absent': '#dc3545',
            'status-pending': '#6c757d',
          }
        }
      }
    }
  </script>
<style data-purpose="custom-shadows">
    .card-shadow {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800">
<!-- BEGIN: MainContainer -->
<div class="max-w-md mx-auto min-h-screen flex flex-col bg-white relative shadow-lg">
<!-- BEGIN: MainHeader -->
<header class="sticky top-0 bg-white z-10 border-b border-slate-100">
<div class="flex items-center p-4">
<!-- Back Button -->
<button class="p-2 -ml-2 text-slate-600" data-purpose="back-button">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<!-- Title and Progress -->
<div class="flex-1 text-center pr-8">
<h1 class="text-lg font-bold text-slate-900 leading-tight">Điểm danh</h1>
<p class="text-xs text-slate-500">Đã điểm danh: 2/19</p>
</div>
</div>
<!-- Progress Indicator Line -->
<div class="w-full h-1 bg-slate-100 overflow-hidden">
<div class="h-full bg-travery-blue w-[20%]" data-purpose="progress-bar"></div>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: CheckInList -->
<main class="flex-1 p-4 space-y-4">
<!-- Item: NOT_CHECKED (Gray) -->
<div class="bg-white rounded-lg flex overflow-hidden card-shadow border border-slate-50" data-purpose="attendance-card">
<div class="w-1.5 bg-slate-400"></div>
<div class="flex-1 flex items-center p-3 gap-3">
<div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div class="flex-1">
<h3 class="font-semibold text-slate-800">Đỗ Minh Anh</h3>
<p class="text-xs text-slate-500 flex items-center">
<span class="mr-1">👤</span> Người lớn
            </p>
</div>
<div class="relative">
<select class="appearance-none bg-white border border-slate-300 text-slate-500 text-xs font-medium rounded-md py-2 px-3 pr-8 focus:outline-none focus:ring-1 focus:ring-travery-blue">
<option>NOT_CHECKED</option>
<option>Đã có mặt</option>
<option>Vắng mặt</option>
</select>
<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-400">
<svg class="h-4 w-4" fill="currentColor" viewbox="0 0 20 20"><path clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill-rule="evenodd"></path></svg>
</div>
</div>
</div>
</div>
<!-- Item: Đã có mặt (Green) -->
<div class="bg-white rounded-lg flex overflow-hidden card-shadow border border-slate-50" data-purpose="attendance-card">
<div class="w-1.5 bg-status-present"></div>
<div class="flex-1 flex items-center p-3 gap-3">
<div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div class="flex-1">
<h3 class="font-semibold text-slate-800">Lê Thu Hà</h3>
<p class="text-xs text-slate-500 flex items-center">
<span class="mr-1">👶</span> Trẻ em
            </p>
</div>
<div class="relative">
<select class="appearance-none bg-green-50 border border-status-present text-status-present text-xs font-semibold rounded-md py-2 px-3 pr-8 focus:outline-none">
<option>Đã có mặt</option>
<option>NOT_CHECKED</option>
<option>Vắng mặt</option>
</select>
<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-status-present">
<svg class="h-4 w-4" fill="currentColor" viewbox="0 0 20 20"><path clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill-rule="evenodd"></path></svg>
</div>
</div>
</div>
</div>
<!-- Item: NOT_CHECKED (Gray) -->
<div class="bg-white rounded-lg flex overflow-hidden card-shadow border border-slate-50" data-purpose="attendance-card">
<div class="w-1.5 bg-slate-400"></div>
<div class="flex-1 flex items-center p-3 gap-3">
<div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div class="flex-1">
<h3 class="font-semibold text-slate-800">Trần Văn Bình</h3>
<p class="text-xs text-slate-500 flex items-center">
<span class="mr-1">👤</span> Người lớn
            </p>
</div>
<div class="relative">
<select class="appearance-none bg-white border border-slate-300 text-slate-500 text-xs font-medium rounded-md py-2 px-3 pr-8 focus:outline-none focus:ring-1 focus:ring-travery-blue">
<option>NOT_CHECKED</option>
<option>Đã có mặt</option>
<option>Vắng mặt</option>
</select>
<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-400">
<svg class="h-4 w-4" fill="currentColor" viewbox="0 0 20 20"><path clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill-rule="evenodd"></path></svg>
</div>
</div>
</div>
</div>
<!-- Item: Vắng mặt (Red) -->
<div class="bg-white rounded-lg flex overflow-hidden card-shadow border border-slate-50" data-purpose="attendance-card">
<div class="w-1.5 bg-status-absent"></div>
<div class="flex-1 flex items-center p-3 gap-3">
<div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-slate-400">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
<div class="flex-1">
<h3 class="font-semibold text-slate-800 leading-tight">Nguyễn Hoàng</h3>
<p class="text-xs text-slate-500 flex items-center mt-0.5">
<span class="mr-1">👤</span> Người lớn
            </p>
</div>
<div class="relative">
<select class="appearance-none bg-red-50 border border-status-absent text-status-absent text-xs font-semibold rounded-md py-2 px-3 pr-8 focus:outline-none">
<option>Vắng mặt</option>
<option>Đã có mặt</option>
<option>NOT_CHECKED</option>
</select>
<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-status-absent">
<svg class="h-4 w-4" fill="currentColor" viewbox="0 0 20 20"><path clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" fill-rule="evenodd"></path></svg>
</div>
</div>
</div>
</div>
</main>
<!-- END: CheckInList -->
<!-- BEGIN: FixedFooter -->
<footer class="mt-auto p-4 bg-white border-t border-slate-200 sticky bottom-0 flex items-center justify-between gap-4">
<button class="text-travery-blue font-semibold text-sm flex-1 text-center py-3" data-purpose="finish-checkin">
        Hoàn tất điểm danh
      </button>
<button class="bg-travery-blue text-white font-semibold text-sm flex-[1.2] py-3 rounded-xl shadow-md hover:bg-blue-600 active:scale-95 transition-transform" data-purpose="save-changes">
        Lưu thay đổi
      </button>
</footer>
<!-- END: FixedFooter -->
</div>
<!-- END: MainContainer -->
</body></html>