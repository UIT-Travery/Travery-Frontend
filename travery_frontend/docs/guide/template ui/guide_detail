<!DOCTYPE html>

<html lang="vi"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Chi tiết chuyến đi - Travery</title>
<!-- Tailwind CSS v3 CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'travery-blue': '#007AFF',
            'travery-light-blue': '#EBF5FF',
            'travery-bg': '#F4F7FB',
            'status-green-bg': '#E7F6EC',
            'status-green-text': '#039855',
            'status-orange-bg': '#FFFAEB',
            'status-orange-text': '#B54708',
            'icon-gray': '#667085',
            'border-gray': '#EAECF0'
          }
        }
      }
    }
  </script>
<style data-purpose="custom-layout">
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #F4F7FB;
    }
    .shadow-card {
      box-shadow: 0px 4px 6px -2px rgba(16, 24, 40, 0.03), 0px 12px 16px -4px rgba(16, 24, 40, 0.08);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
<!-- BEGIN: Navigation Header -->
<header class="bg-white px-4 py-4 flex items-center gap-4 sticky top-0 z-10">
<button aria-label="Back" class="p-1">
<svg fill="none" height="24" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
<path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="#007AFF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
<h1 class="text-lg font-bold text-slate-800 leading-tight">
      Khám phá Vịnh Hạ Long<br/>- Đảo Tuần Châu
    </h1>
</header>
<!-- END: Navigation Header -->
<main class="flex-1 px-4 py-4 space-y-4 pb-24">
<!-- BEGIN: Trip Info Section -->
<section class="bg-white rounded-2xl p-4 border-l-4 border-green-500 shadow-card" data-purpose="trip-info">
<div class="flex justify-between items-start mb-4">
<h2 class="text-lg font-bold text-slate-800">Thông tin chuyến đi</h2>
<span class="bg-status-green-bg text-status-green-text text-[10px] font-bold px-2 py-1 rounded">ĐANG DIỄN RA</span>
</div>
<div class="grid grid-cols-2 gap-4">
<!-- Departure Date -->
<div class="flex items-start gap-3">
<div class="bg-gray-100 p-2 rounded-xl">
<svg class="text-icon-gray" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="20">
<rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line>
</svg>
</div>
<div>
<p class="text-xs text-gray-400">Ngày khởi hành</p>
<p class="text-sm font-bold text-slate-800">19/08 - 21/08/2026</p>
</div>
</div>
<!-- Duration -->
<div class="flex items-start gap-3">
<div class="bg-gray-100 p-2 rounded-xl">
<svg class="text-icon-gray" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="20">
<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
</svg>
</div>
<div>
<p class="text-xs text-gray-400">Thời gian</p>
<p class="text-sm font-bold text-slate-800">3 ngày 2 đêm</p>
</div>
</div>
</div>
</section>
<!-- END: Trip Info Section -->
<!-- BEGIN: Transport & Driver Section -->
<section class="bg-white rounded-2xl p-4 shadow-card" data-purpose="transport-info">
<h2 class="text-lg font-bold text-slate-800 mb-4">Phương tiện &amp; Tài xế</h2>
<div class="flex items-center gap-4">
<div class="bg-travery-light-blue p-4 rounded-xl">
<svg fill="none" height="32" stroke="#007AFF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="32">
<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-1.1 0-2 .9-2 2v9c0 .6.4 1 1 1h2"></path>
<circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle>
</svg>
</div>
<div>
<div class="flex items-center gap-2">
<span class="text-xl font-bold text-slate-800 tracking-wide">51B-100.00</span>
<span class="bg-gray-200 text-[10px] text-gray-500 font-bold px-1.5 py-0.5 rounded uppercase">SEAT</span>
</div>
<p class="text-sm text-gray-500">Tài xế Dương</p>
</div>
</div>
</section>
<!-- END: Transport & Driver Section -->
<!-- BEGIN: Passenger List Section -->
<section data-purpose="passenger-list-container">
<h2 class="text-lg font-bold text-slate-800 mb-4">Danh sách hành khách (12)</h2>
<div class="space-y-3">
<!-- Group 1: Expanded -->
<div class="bg-white rounded-2xl border border-border-gray shadow-card overflow-hidden">
<div class="p-4 flex justify-between items-center cursor-pointer">
<div>
<h3 class="font-bold text-slate-800">Hồ Đức Tuấn (4 thành viên)</h3>
<p class="text-xs text-green-600 font-medium">Đã thanh toán</p>
</div>
<svg class="text-gray-400" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="20">
<polyline points="18 15 12 9 6 15"></polyline>
</svg>
</div>
<div class="border-t border-border-gray px-4 py-2 bg-white">
<!-- Passenger 1 -->
<div class="flex items-center justify-between py-3">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center">
<svg fill="none" height="16" stroke="#2DD4BF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="16"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
</div>
<span class="text-sm font-medium text-slate-700">Hồ Đức Tuấn</span>
</div>
<span class="bg-gray-100 text-gray-500 text-[10px] px-2 py-0.5 rounded">Người lớn</span>
</div>
<!-- Passenger 2 -->
<div class="flex items-center justify-between py-3 border-t border-gray-50">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-teal-50 flex items-center justify-center">
<svg fill="none" height="16" stroke="#2DD4BF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="16"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
</div>
<span class="text-sm font-medium text-slate-700">Nguyễn Thị Mai</span>
</div>
<span class="bg-gray-100 text-gray-500 text-[10px] px-2 py-0.5 rounded">Người lớn</span>
</div>
<!-- Passenger 3 -->
<div class="flex items-center justify-between py-3 border-t border-gray-50">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center">
<svg fill="none" height="16" stroke="#22D3EE" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="16"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
</div>
<span class="text-sm font-medium text-slate-700">Hồ Minh Anh</span>
</div>
<span class="bg-gray-100 text-gray-500 text-[10px] px-2 py-0.5 rounded">Trẻ em</span>
</div>
<!-- Passenger 4 -->
<div class="flex items-center justify-between py-3 border-t border-gray-50">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-cyan-50 flex items-center justify-center">
<svg fill="none" height="16" stroke="#22D3EE" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="16"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
</div>
<span class="text-sm font-medium text-slate-700">Hồ Gia Bảo</span>
</div>
<span class="bg-gray-100 text-gray-500 text-[10px] px-2 py-0.5 rounded">Trẻ em</span>
</div>
</div>
</div>
<!-- Group 2: Collapsed -->
<div class="bg-white rounded-2xl border border-border-gray shadow-card">
<div class="p-4 flex justify-between items-center cursor-pointer">
<div>
<h3 class="font-bold text-slate-800">Lê Văn Tám (2 thành viên)</h3>
<p class="text-xs text-travery-blue font-medium">Chờ thanh toán</p>
</div>
<svg class="text-gray-400" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="20">
<polyline points="6 9 12 15 18 9"></polyline>
</svg>
</div>
</div>
</div>
</section>
<!-- END: Passenger List Section -->
</main>
<!-- BEGIN: Bottom Action Buttons -->
<footer class="fixed bottom-0 left-0 right-0 bg-white p-4 border-t border-gray-100 flex gap-3 z-20">
<button class="flex-1 py-3 px-4 rounded-xl border border-travery-blue text-travery-blue font-bold text-sm bg-white active:bg-blue-50">
      Điểm danh
    </button>
<button class="flex-1 py-3 px-4 rounded-xl bg-travery-blue text-white font-bold text-sm shadow-md shadow-blue-200 active:bg-blue-700">
      Cập nhật tiến độ
    </button>
</footer>
<!-- END: Bottom Action Buttons -->
</body></html>