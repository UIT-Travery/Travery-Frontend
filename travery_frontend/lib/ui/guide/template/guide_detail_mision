<!DOCTYPE html><html lang="vi"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Chi tiết Nhiệm vụ</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              blue: '#0066cc',
              lightBlue: '#e8f0fe',
              textBlue: '#004a99',
              bgGray: '#f8faff',
            }
          }
        }
      }
    }
  </script>
<style data-purpose="custom-shadows">
    .card-shadow {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .button-shadow {
      box-shadow: 0 4px 12px rgba(0, 102, 204, 0.2);
    }
  </style>
</head>
<body class="bg-brand-bgGray min-h-screen font-sans text-slate-800">
<!-- BEGIN: MainContainer -->
<div class="max-w-md mx-auto min-h-screen bg-white relative">
<!-- BEGIN: Header -->
<header class="flex items-center justify-between px-4 py-4 bg-white sticky top-0 z-10 border-b border-gray-50">
<button aria-label="Back" class="w-10 h-10 flex items-center justify-start text-brand-textBlue">
<i class="fa-solid fa-arrow-left text-lg"></i>
</button>
<h1 class="text-brand-textBlue font-bold text-lg flex-1 text-center">Chi tiết Nhiệm vụ</h1>
<div class="w-10"></div> <!-- Spacer for centering -->
</header>
<!-- END: Header -->
<!-- BEGIN: ContentArea -->
<main class="p-4 space-y-5 bg-[#f5f8ff] min-h-[calc(100vh-64px)]">
<!-- BEGIN: TourCard -->
<section class="bg-white rounded-2xl overflow-hidden card-shadow" data-purpose="tour-info-card">
<!-- Hero Image -->
<div class="w-full h-48 overflow-hidden">
<img alt="Vịnh Hạ Long" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCbnfITBGonePpe9ZuPcNYZho0Cv6XaM3P6QXxzH8dvAVgJd95KV-9uHqv8AW4q1VWp554C61PaI9ys8foK1xGJQVVr0OcmBc2CdDreEGp5muxqth2ANmONhXH_trN1SM4XDKdLei8Fz3CZwX9wQAPZsG_IxSpphLbCSug8gB3xxsQA-g-TGHjX2SsmZ1nKs6_kiefX_xzC8jzUbs0uJlC2YRGzLNVgHbJoxMHW98B3FTRYyfxazRsoEBRJZ2X7sNRsgD6FsqAa">
</div>
<!-- Tour Details -->
<div class="p-5">
<h2 class="text-lg font-extrabold text-slate-800 leading-tight mb-4">
            Khám phá Vịnh Hạ Long - Đảo Tuần Châu
          </h2>
<div class="flex justify-between items-start">
<div>
<p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">MÃ TOUR</p>
<p class="text-brand-blue font-bold text-sm">#HL240502-VIP</p>
</div>
<div class="text-right">
<p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">NGÀY KHỞI HÀNH</p>
<p class="text-slate-700 font-bold text-sm">15/10/2024</p>
</div>
</div>
</div>
</section>
<!-- END: TourCard -->
<!-- BEGIN: ActionButtons -->
<section class="grid grid-cols-2 gap-4" data-purpose="action-buttons-container">
<!-- Check-in Button -->
<button class="bg-brand-blue rounded-2xl flex flex-col items-center justify-center text-white button-shadow py-3 px-2">
<div class="bg-white/20 rounded-xl p-2 mb-1">
<i class="fa-solid fa-list-check text-xl"></i>
</div>
<span class="text-xs font-bold text-center leading-snug">Điểm danh đoàn<br>(Check-in)</span>
</button>
<!-- Progress Update Button -->
<button class="bg-brand-blue rounded-2xl flex flex-col items-center justify-center text-white button-shadow py-3 px-2">
<div class="bg-white/20 rounded-xl p-2 mb-1">
<i class="fa-solid fa-chart-line text-xl"></i>
</div>
<span class="text-xs font-bold text-center leading-snug">Cập nhật<br>Tiến độ</span>
</button>
</section>
<!-- END: ActionButtons -->
<!-- BEGIN: OperationalInfo -->
<section class="bg-white rounded-2xl p-5 card-shadow" data-purpose="operational-details">
<h3 class="text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-6">THÔNG TIN VẬN HÀNH</h3>
<div class="space-y-6">
<!-- License Plate -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 bg-brand-lightBlue rounded-full flex items-center justify-center flex-shrink-0">
<i class="fa-solid fa-bus text-brand-blue text-xl"></i>
</div>
<div>
<p class="text-[10px] font-semibold text-gray-400 uppercase">Biển số xe</p>
<p class="text-slate-800 font-bold text-base">29B-123.45</p>
</div>
</div>
<!-- Driver Info -->
<div class="flex items-center justify-between">
<div class="flex items-center gap-4">
<div class="w-12 h-12 bg-brand-lightBlue rounded-full flex items-center justify-center flex-shrink-0">
<i class="fa-solid fa-user text-brand-blue text-xl"></i>
</div>
<div>
<p class="text-[10px] font-semibold text-gray-400 uppercase">Tài xế</p>
<p class="text-slate-800 font-bold text-base">Nguyễn Văn Hùng</p>
</div>
</div>
<a class="w-10 h-10 bg-brand-lightBlue rounded-full flex items-center justify-center text-brand-blue" href="tel:0000000000">
<i class="fa-solid fa-phone"></i>
</a>
</div>
<!-- Hotel Info -->
<div class="flex items-center gap-4">
<div class="w-12 h-12 bg-brand-lightBlue rounded-full flex items-center justify-center flex-shrink-0">
<i class="fa-solid fa-hotel text-brand-blue text-xl"></i>
</div>
<div>
<p class="text-[10px] font-semibold text-gray-400 uppercase">Khách sạn</p>
<p class="text-slate-800 font-bold text-base">Vinpearl Resort &amp; Spa Hạ Long</p>
</div>
</div>
</div>
</section>
<!-- END: OperationalInfo -->
</main>
<!-- END: ContentArea -->
</div>
<!-- END: MainContainer -->




</body></html>