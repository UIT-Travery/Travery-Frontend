<!DOCTYPE html>

<html lang="vi"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Tiến độ tour</title>
<!-- Tailwind CSS v3 CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'brand-blue': '#0066da',
            'brand-light-blue': '#eff6ff',
            'brand-grey': '#f1f5f9',
            'brand-text-muted': '#64748b',
            'status-blue-bg': '#e0f2fe',
          }
        }
      }
    }
  </script>
<style data-purpose="custom-layout">
    /* Timeline vertical line */
    .timeline-line {
      position: absolute;
      left: 11px;
      top: 24px;
      bottom: -24px;
      width: 2px;
      background-color: #e2e8f0;
    }
    .timeline-step:last-child .timeline-line {
      display: none;
    }
    /* Rounded corner detail on main card */
    .corner-accent {
      position: absolute;
      top: 0;
      right: 0;
      width: 60px;
      height: 60px;
      background: #f1f5f9;
      border-bottom-left-radius: 100%;
      opacity: 0.5;
    }
  </style>
</head>
<body class="bg-slate-50 font-sans text-slate-900 min-h-screen flex justify-center">
<!-- BEGIN: MobileContainer -->
<div class="w-full max-w-[430px] bg-white shadow-lg min-h-screen flex flex-col">
<!-- BEGIN: MainHeader -->
<header class="sticky top-0 bg-white z-10 px-4 py-3 flex items-center border-b border-slate-100">
<button class="p-2 -ml-2 text-brand-blue" data-purpose="back-button">
<svg class="h-6 w-6" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
<div class="flex-1 text-center">
<h1 class="text-sm font-bold uppercase text-slate-800">Tiến độ tour</h1>
<p class="text-[10px] text-slate-500 font-medium">HL240502-VIP</p>
</div>
<div class="w-10"></div> <!-- Spacer for centering -->
</header>
<!-- END: MainHeader -->
<!-- BEGIN: MainContent -->
<main class="flex-1 p-4 bg-brand-light-blue/30">
<!-- BEGIN: CurrentTourCard -->
<section class="bg-white rounded-3xl p-6 shadow-sm mb-4 relative overflow-hidden" data-purpose="tour-info-card">
<div class="corner-accent"></div>
<span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider">Tour hiện tại</span>
<h2 class="text-lg font-bold mt-2 leading-tight">Khám phá Vịnh Hạ Long<br/>- Đảo Tuần Châu</h2>
<div class="flex items-center mt-3 text-brand-text-muted">
<svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M9 20l-5.447-2.724A2 2 0 013 15.483V5.483a2 2 0 011.553-1.943l7.19-1.438a2 2 0 011.514.372l5.447 2.724A2 2 0 0120 7.017v10.017a2 2 0 01-1.553 1.943l-7.19 1.438a2 2 0 01-1.514-.372z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
<span class="text-xs">Mã tour: HL240502-VIP</span>
</div>
</section>
<!-- END: CurrentTourCard -->
<!-- BEGIN: InfoSummaryCards -->
<section class="grid grid-cols-2 gap-3 mb-8">
<!-- Driver Card -->
<div class="bg-brand-light-blue/60 rounded-2xl p-4 flex flex-col gap-2">
<div class="flex items-center gap-2">
<div class="w-7 h-7 bg-white rounded-full flex items-center justify-center shadow-sm">
<svg class="h-4 w-4 text-brand-blue" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<span class="text-[10px] font-bold text-brand-text-muted uppercase">Tài xế</span>
</div>
<div>
<p class="text-sm font-bold text-slate-800">Nguyễn Văn An</p>
<p class="text-[10px] text-slate-500">Xe: 29B-123.45</p>
</div>
</div>
<!-- Members Card -->
<div class="bg-brand-light-blue/60 rounded-2xl p-4 flex flex-col gap-2">
<div class="flex items-center gap-2">
<div class="w-7 h-7 bg-white rounded-full flex items-center justify-center shadow-sm">
<svg class="h-4 w-4 text-brand-blue" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<span class="text-[10px] font-bold text-brand-text-muted uppercase">Thành viên</span>
</div>
<div>
<p class="text-sm font-bold text-slate-800">24 thành viên</p>
</div>
</div>
</section>
<!-- END: InfoSummaryCards -->
<!-- BEGIN: TripProgress -->
<section data-purpose="trip-timeline">
<h3 class="text-lg font-bold text-slate-900 mb-6">Tiến độ chuyến đi</h3>
<div class="space-y-4">
<!-- Step 1: Completed -->
<div class="relative pl-10 timeline-step">
<div class="timeline-line"></div>
<div class="absolute left-0 top-1 w-6 h-6 bg-brand-blue rounded-full flex items-center justify-center z-10">
<svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-50">
<div class="flex justify-between items-start mb-2">
<h4 class="font-bold text-slate-800">Đón khách</h4>
<span class="text-[9px] font-bold text-brand-blue bg-blue-50 px-2 py-0.5 rounded uppercase">Hoàn thành</span>
</div>
<p class="text-xs text-slate-600 leading-relaxed">Đã đón đủ 24 khách tại điểm hẹn Sân bay Nội Bài.</p>
<p class="text-[9px] text-slate-400 mt-2 italic">Cập nhật lúc 08:30 AM</p>
</div>
</div>
<!-- Step 2: In Progress -->
<div class="relative pl-10 timeline-step">
<div class="timeline-line"></div>
<div class="absolute left-0 top-1 w-6 h-6 bg-brand-blue rounded-full flex items-center justify-center z-10 border-4 border-white shadow-sm ring-1 ring-brand-blue">
<div class="w-2 h-2 bg-white rounded-full"></div>
</div>
<div class="bg-blue-50 rounded-2xl p-4 shadow-sm border border-blue-100">
<div class="flex justify-between items-start mb-2">
<h4 class="font-bold text-brand-blue">Di chuyển</h4>
<div class="flex items-center gap-1">
<span class="w-1.5 h-1.5 bg-brand-blue rounded-full animate-pulse"></span>
<span class="text-[9px] font-bold text-brand-blue uppercase">Đang diễn ra</span>
</div>
</div>
<p class="text-xs text-slate-600 leading-relaxed mb-4">Đoàn đang di chuyển trên cao tốc Hà Nội - Hải Phòng. Dự kiến tới H Long sau 45 phút.</p>
<button class="w-full bg-brand-blue text-white text-sm font-bold py-3 rounded-xl flex items-center justify-center gap-2 active:bg-blue-700 transition-colors">
<svg class="h-4 w-4" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
                Xác nhận hoàn thành
              </button>
</div>
</div>
<!-- Step 3: Upcoming -->
<div class="relative pl-10 timeline-step opacity-50">
<div class="timeline-line"></div>
<div class="absolute left-1.5 top-2.5 w-3 h-3 bg-slate-300 rounded-full z-10"></div>
<div class="bg-slate-50/50 rounded-2xl p-4 border border-dashed border-slate-200">
<h4 class="font-bold text-slate-500 mb-1">Nhận phòng khách sạn</h4>
<p class="text-xs text-slate-400">Check-in tại Vinpearl Resort &amp; Spa Ha Long.</p>
</div>
</div>
<!-- Step 4: Upcoming -->
<div class="relative pl-10 timeline-step opacity-50">
<div class="timeline-line"></div>
<div class="absolute left-1.5 top-2.5 w-3 h-3 bg-slate-300 rounded-full z-10"></div>
<div class="bg-slate-50/50 rounded-2xl p-4 border border-dashed border-slate-200">
<h4 class="font-bold text-slate-500 mb-1">Tham quan</h4>
<p class="text-xs text-slate-400">Tham quan Động Thiên Cung và chèo Kayak.</p>
</div>
</div>
<!-- Step 5: Final -->
<div class="relative pl-10 timeline-step opacity-50">
<div class="absolute left-1.5 top-2.5 w-3 h-3 bg-slate-300 rounded-full z-10"></div>
<div class="bg-slate-50/50 rounded-2xl p-4 border border-dashed border-slate-200">
<h4 class="font-bold text-slate-500 mb-1">Kết thúc</h4>
<p class="text-xs text-slate-400">Đưa khách về điểm hẹn và trả khách.</p>
</div>
</div>
</div>
</section>
<!-- END: TripProgress -->
<!-- BEGIN: ReportIssue -->
<section class="mt-12 mb-6">
<button class="w-full bg-white p-4 rounded-2xl shadow-md flex items-center gap-4 border border-red-50 active:bg-red-50 transition-colors" data-purpose="report-issue-button">
<div class="w-12 h-12 bg-red-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-red-200">
<svg class="h-6 w-6" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<div class="flex-1 text-left">
<p class="text-sm font-bold text-red-700">Báo cáo sự cố</p>
<p class="text-[10px] text-red-500/80 leading-tight">Gửi thông báo khẩn cấp về văn phòng điều hành</p>
</div>
<svg class="h-4 w-4 text-slate-300" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
</section>
<!-- END: ReportIssue -->
</main>
<!-- END: MainContent -->
</div>
<!-- END: MobileContainer -->
</body></html>