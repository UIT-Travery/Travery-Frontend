<path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</div>
<input class="block w-full pl-11 pr-4 py-4 border-none bg-white rounded-2xl text-sm focus:ring-2 focus:ring-brand-blue card-shadow placeholder-gray-400" placeholder="Tìm tên khách, số CCCD..." type="text"/>
</section>
<!-- END: Search Bar -->
<!-- BEGIN: Customer List -->
<section class="space-y-4" data-purpose="customer-list">
