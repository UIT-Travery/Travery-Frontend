<!DOCTYPE html>

<html lang="vi"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Check-in Screen</title>
<!-- BEGIN: Scripts -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              blue: '#0066D6',
              lightBlue: '#E8F2FF',
              grayText: '#718096',
              cardBg: '#FFFFFF',
              statusGreen: '#E6F4EA',
              statusGreenText: '#1E8E3E',
              statusRed: '#FEE2E2',
              statusRedText: '#DC2626'
            }
          }
        }
      }
    }
  </script>
<!-- END: Scripts -->
<!-- BEGIN: Styles -->
<style data-purpose="custom-layout">
    body {
      background-color: #F8FAFC;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .safe-bottom {
      padding-bottom: env(safe-area-inset-bottom);
    }
    /* Simple progress bar styling */
    .progress-bar-container {
      height: 6px;
      background-color: rgba(255, 255, 255, 0.3);
      border-radius: 3px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      background-color: #FFFFFF;
      width: 60%; /* Represents 15/25 */
    }
    /* Shadow for card elements */
    .card-shadow {
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }
  </style>
<!-- END: Styles -->
</head>
<body class="flex flex-col min-h-screen max-w-md mx-auto bg-white border-x border-gray-100">
<!-- BEGIN: Header -->
<header class="sticky top-0 bg-white z-10 px-4 py-4 flex items-center justify-between border-b border-gray-50">
<button class="p-2 -ml-2" data-purpose="back-button">
<svg class="h-6 w-6 text-brand-blue" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
<div class="text-center">
<h1 class="text-lg font-bold text-gray-900">Check-in</h1>
<p class="text-xs font-semibold text-brand-blue tracking-tight">VN-DAD-2024-05</p>
</div>
<div class="w-10"></div> <!-- Spacer for centering -->
</header>
<!-- END: Header -->
<main class="flex-1 px-4 py-6 space-y-6 overflow-y-auto">
<!-- BEGIN: Progress Card -->
<section class="bg-gradient-to-r from-blue-500 to-brand-blue rounded-3xl p-6 text-white card-shadow relative overflow-hidden" data-purpose="summary-card">
<div class="flex justify-between items-start mb-4">
<div>
<p class="text-sm opacity-80 mb-1">Tiến độ điểm danh</p>
<p class="text-3xl font-extrabold">15/25</p>
<span class="inline-block mt-2 px-3 py-1 bg-white/20 rounded-full text-[10px] font-medium uppercase">Khách đã có mặt</span>
</div>
<div class="opacity-20">
<svg class="h-12 w-12" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
</svg>
</div>
</div>
<div class="progress-bar-container">
<div class="progress-bar-fill"></div>
</div>
</section>
<!-- END: Progress Card -->
<!-- BEGIN: Search Bar -->
<section class="relative" data-purpose="search-container">
<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
