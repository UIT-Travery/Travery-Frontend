<!DOCTYPE html><html class="light" lang="vi"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        input:focus, select:focus {
            outline: none !important;
            border-color: #0052cc !important;
            box-shadow: 0 0 0 2px rgba(0, 82, 204, 0.1) !important;
        }

        .input-field {
            @apply w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 transition-all duration-200;
        }

        .floating-label {
            @apply font-label-md text-secondary mb-xs block ml-xs;
        }
    </style>
<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "text-dark": "#172B4D",
                      "secondary-fixed": "#e2e2e2",
                      "on-tertiary-fixed-variant": "#812800",
                      "surface-container": "#e7eeff",
                      "on-background": "#101c2d",
                      "outline": "#737685",
                      "warning": "#FFAB00",
                      "surface-container-low": "#f0f3ff",
                      "secondary": "#5d5f5f",
                      "outline-variant": "#c3c6d6",
                      "inverse-on-surface": "#ebf1ff",
                      "on-secondary-fixed": "#1a1c1c",
                      "inverse-primary": "#b2c5ff",
                      "tertiary": "#7b2600",
                      "secondary-fixed-dim": "#c6c6c7",
                      "error-container": "#ffdad6",
                      "background": "#f9f9ff",
                      "inverse-surface": "#253143",
                      "surface-variant": "#d7e3fb",
                      "on-surface-variant": "#434654",
                      "surface-container-highest": "#d7e3fb",
                      "on-tertiary-fixed": "#380d00",
                      "error": "#FF5630",
                      "on-secondary-container": "#616363",
                      "tertiary-fixed-dim": "#ffb59b",
                      "surface-dim": "#cedbf2",
                      "tertiary-container": "#a33500",
                      "primary-fixed": "#dae2ff",
                      "on-primary-container": "#c4d2ff",
                      "surface-container-lowest": "#ffffff",
                      "on-primary": "#ffffff",
                      "surface-bright": "#f9f9ff",
                      "on-tertiary-container": "#ffc6b2",
                      "surface-tint": "#0c56d0",
                      "on-secondary-fixed-variant": "#454747",
                      "on-error": "#ffffff",
                      "on-tertiary": "#ffffff",
                      "primary": "#003d9b",
                      "on-surface": "#101c2d",
                      "on-secondary": "#ffffff",
                      "primary-container": "#0052cc",
                      "tertiary-fixed": "#ffdbcf",
                      "surface-gray": "#F4F5F7",
                      "surface-container-high": "#dee9ff",
                      "on-primary-fixed": "#001848",
                      "secondary-container": "#dfe0e0",
                      "surface-blue": "#F4F7FF",
                      "surface": "#f9f9ff",
                      "on-primary-fixed-variant": "#0040a2",
                      "primary-fixed-dim": "#b2c5ff",
                      "success": "#36B37E",
                      "on-error-container": "#93000a"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "container-padding": "20px",
                      "xs": "4px",
                      "base": "8px",
                      "sm": "8px",
                      "md": "16px",
                      "lg": "24px",
                      "xl": "32px",
                      "gutter": "12px"
              },
              "fontFamily": {
                      "headline-md": ["Inter"],
                      "label-md": ["Inter"],
                      "display-lg": ["Inter"],
                      "headline-sm": ["Inter"],
                      "body-lg": ["Inter"],
                      "body-md": ["Inter"],
                      "label-sm": ["Inter"]
              },
              "fontSize": {
                      "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                      "display-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                      "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                      "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                      "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}]
              }
            },
          },
        }
    </script>
</head>
<body class="bg-background text-on-surface font-body-md antialiased min-h-screen flex flex-col">
<!-- Top AppBar -->
<nav class="flex items-center justify-between px-container-padding h-14 w-full z-40 bg-surface fixed top-0 left-0">
<button aria-label="Back" class="active:scale-95 transition-transform p-2 -ml-2 text-primary">
<span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
</button>
<h1 class="font-headline-sm text-headline-sm flex-1 ml-4 text-primary">Chỉnh sửa hồ sơ</h1>
<div class="w-10"></div> <!-- Spacer for balance -->
</nav>
<!-- Main Content -->
<main class="flex-1 mt-14 mb-24 overflow-y-auto no-scrollbar">
<div class="px-container-padding pt-lg pb-xl">
<!-- Avatar Section -->
<div class="flex flex-col items-center mb-xl">
<div class="relative group cursor-pointer" onclick="document.getElementById('avatar-upload').click()">
<div class="w-28 h-28 rounded-full overflow-hidden border-4 border-white shadow-lg bg-surface-gray">
<img class="w-full h-full object-cover" data-alt="A professional close-up portrait of a friendly man in his 30s with a clean-cut look, set against a blurred travel destination background. The lighting is natural and bright, enhancing the minimalist and modern aesthetic of the high-end travel application. The overall color palette is dominated by clean whites and soft blues, conveying a sense of reliability and premium service." id="profile-img" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDz1hRdMv-aG6-KF0KqR5QK0c-uDEtBD8nSFtqpoIAQFxrnz3k1b7j0PQXhMyVNJOniQsoMSAn25EeP0f2BQLZwhuGMEARLD2cqUujW3-R73xFJvosx5Kimp7qW1iZuI3xWhpzQCQzvV13Qx1cemTQ0utTjdpLuuGIPUzW7wpqDpo9htCRd4iIK2o0XJPwOIIZsQbiEJSCGpKOari_B27CDV_qRO7KTpGMcapeDbh-W66NSoV4TVCiDgNzI7JC6ssY8z7xG-27dYw0">
</div>
<div class="absolute bottom-0 right-0 bg-primary p-2 rounded-full border-4 border-white shadow-md text-white active:scale-90 transition-transform">
<span class="material-symbols-outlined !text-[20px]" data-icon="photo_camera">photo_camera</span>
</div>
<input accept="image/*" class="hidden" id="avatar-upload" type="file">
</div>
<p class="mt-md font-label-md text-secondary">Thay đổi ảnh đại diện</p>
</div>
<!-- Form Fields -->
<form class="space-y-lg">
<!-- Full Name -->
<div class="space-y-xs">
<label class="floating-label">Họ và tên</label>
<input class="w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 focus:border-primary focus:bg-surface transition-all outline-none" placeholder="Nhập họ tên" type="text" value="John Doe">
</div>
<!-- Phone -->
<div class="space-y-xs">
<label class="floating-label">Số điện thoại</label>
<div class="relative">
<input class="w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 focus:border-primary focus:bg-surface transition-all outline-none" placeholder="Nhập số điện thoại" type="tel" value="+84 123 456 789">
<span class="absolute right-md top-1/2 -translate-y-1/2 text-success material-symbols-outlined" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
</div>
<!-- DOB & Gender Grid -->
<div class="grid grid-cols-2 gap-md">
<div class="space-y-xs">
<label class="floating-label">Ngày sinh</label>
<div class="relative">
<input class="w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 focus:border-primary focus:bg-surface transition-all outline-none appearance-none" type="date" value="1990-01-01">
<span class="absolute right-md top-1/2 -translate-y-1/2 text-secondary pointer-events-none material-symbols-outlined" data-icon="calendar_today">calendar_today</span>
</div>
</div>
<div class="space-y-xs">
<label class="floating-label">Giới tính</label>
<div class="relative">
<select class="w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 focus:border-primary focus:bg-surface transition-all outline-none appearance-none">
<option selected="" value="male">Nam</option>
<option value="female">Nữ</option>
<option value="other">Khác</option>
</select>
<span class="absolute right-md top-1/2 -translate-y-1/2 text-secondary pointer-events-none material-symbols-outlined" data-icon="expand_more">expand_more</span>
</div>
</div>
</div>
<!-- Passport -->
<div class="space-y-xs">
<label class="floating-label">Số hộ chiếu (Passport)</label>
<input class="w-full h-12 bg-surface-gray rounded-xl px-md font-body-md text-on-surface border-transparent border-2 focus:border-primary focus:bg-surface transition-all outline-none" placeholder="Nhập số hộ chiếu" type="text">
</div>
<!-- Email (Read-only) -->
<div class="space-y-xs">
<label class="floating-label">Email</label>
<div class="relative group">
<input class="w-full h-12 bg-surface-container-low text-secondary rounded-xl px-md font-body-md border-transparent border-2 cursor-not-allowed outline-none" readonly="" type="email" value="john.doe@example.com">
<span class="absolute right-md top-1/2 -translate-y-1/2 text-outline material-symbols-outlined" data-icon="lock">lock</span>
</div>
<p class="text-label-sm font-label-sm text-secondary ml-xs">Email không thể thay đổi để đảm bảo bảo mật tài khoản.</p>
</div>
</form>
</div>
</main>
<!-- Fixed Bottom Action Area -->
<div class="fixed bottom-0 left-0 w-full p-container-padding bg-surface/80 backdrop-blur-md z-40">
<button class="w-full h-12 bg-primary text-white rounded-xl font-headline-sm text-headline-sm shadow-lg shadow-primary/20 active:scale-[0.98] transition-all duration-200">
            Lưu thay đổi
        </button>
</div>
<!-- Hidden Bottom NavBar Suppression for Sub-page -->
<nav class="hidden">
<!-- Suppressed according to UX Goal for focused journey -->
</nav>
<script>
        // Micro-interactions for form inputs
        document.querySelectorAll('input, select').forEach(element => {
            element.addEventListener('focus', () => {
                element.parentElement.querySelector('.floating-label')?.classList.add('text-primary');
            });
            element.addEventListener('blur', () => {
                element.parentElement.querySelector('.floating-label')?.classList.remove('text-primary');
            });
        });

        // Simple avatar preview
        document.getElementById('avatar-upload').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    document.getElementById('profile-img').src = event.target.result;
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // Click handler for back button (demo purposes)
        document.querySelector('nav button').addEventListener('click', () => {
            console.log('Navigating back...');
            // In a real app: window.history.back();
        });
    </script>
</body></html>