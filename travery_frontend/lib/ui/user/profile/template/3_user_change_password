<!DOCTYPE html><html lang="vi"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport">
<title>Đổi mật khẩu - TravelPro</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .password-input:focus-within {
            box-shadow: 0 0 0 2px #003d9b;
        }
    </style>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "text-dark": "#172B4D",
                    "secondary-fixed": "#e2e2e2",
                    "on-tertiary-fixed-variant": "#812800",
                    "surface-container": "#e7eeff",
                    "on-background": "#101c2d",
                    "outline": "#737685",
                    "warning": "#FFAB00",
                    "surface-container-low": "#f0f3ff",
                    "secondary": "#5d5f5f",
                    "outline-variant": "#c3c6d6",
                    "inverse-on-surface": "#ebf1ff",
                    "on-secondary-fixed": "#1a1c1c",
                    "inverse-primary": "#b2c5ff",
                    "tertiary": "#7b2600",
                    "secondary-fixed-dim": "#c6c6c7",
                    "error-container": "#ffdad6",
                    "background": "#f9f9ff",
                    "inverse-surface": "#253143",
                    "surface-variant": "#d7e3fb",
                    "on-surface-variant": "#434654",
                    "surface-container-highest": "#d7e3fb",
                    "on-tertiary-fixed": "#380d00",
                    "error": "#FF5630",
                    "on-secondary-container": "#616363",
                    "tertiary-fixed-dim": "#ffb59b",
                    "surface-dim": "#cedbf2",
                    "tertiary-container": "#a33500",
                    "primary-fixed": "#dae2ff",
                    "on-primary-container": "#c4d2ff",
                    "surface-container-lowest": "#ffffff",
                    "on-primary": "#ffffff",
                    "surface-bright": "#f9f9ff",
                    "on-tertiary-container": "#ffc6b2",
                    "surface-tint": "#0c56d0",
                    "on-secondary-fixed-variant": "#454747",
                    "on-error": "#ffffff",
                    "on-tertiary": "#ffffff",
                    "primary": "#003d9b",
                    "on-surface": "#101c2d",
                    "on-secondary": "#ffffff",
                    "primary-container": "#0052cc",
                    "tertiary-fixed": "#ffdbcf",
                    "surface-gray": "#F4F5F7",
                    "surface-container-high": "#dee9ff",
                    "on-primary-fixed": "#001848",
                    "secondary-container": "#dfe0e0",
                    "surface-blue": "#F4F7FF",
                    "surface": "#f9f9ff",
                    "on-primary-fixed-variant": "#0040a2",
                    "primary-fixed-dim": "#b2c5ff",
                    "success": "#36B37E",
                    "on-error-container": "#93000a"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "container-padding": "20px",
                    "xs": "4px",
                    "base": "8px",
                    "sm": "8px",
                    "md": "16px",
                    "lg": "24px",
                    "xl": "32px",
                    "gutter": "12px"
            },
            "fontFamily": {
                    "headline-md": ["Inter"],
                    "label-md": ["Inter"],
                    "display-lg": ["Inter"],
                    "headline-sm": ["Inter"],
                    "body-lg": ["Inter"],
                    "body-md": ["Inter"],
                    "label-sm": ["Inter"]
            },
            "fontSize": {
                    "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                    "display-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}]
            }
          },
        },
      }
    </script>
</head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<!-- TopAppBar -->
<header class="flex items-center justify-between px-container-padding h-14 w-full z-40 bg-surface dark:bg-surface fixed top-0 left-0">
<div class="flex items-center gap-4">
<button class="hover:bg-surface-container-low dark:hover:bg-surface-container-highest transition-colors p-2 rounded-full active:scale-95 transition-transform text-primary dark:text-primary-fixed" onclick="history.back()">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<h1 class="font-headline-sm text-[20px] font-bold text-on-surface">Đổi mật khẩu</h1>
</div>
<div class="w-10"></div> <!-- Spacer for visual balance -->
</header>
<!-- Main Content Canvas -->
<main class="flex-grow pt-20 pb-10 px-container-padding max-w-md mx-auto w-full">
<!-- Brand Illustration / Header Context -->
<div class="mb-8 flex justify-center">
<div class="relative w-24 h-24 bg-surface-container-low rounded-full flex items-center justify-center">
<span class="material-symbols-outlined text-[48px] text-primary" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
<div class="absolute -bottom-1 -right-1 bg-success text-white rounded-full p-1.5 border-4 border-surface">
<span class="material-symbols-outlined text-[18px]">verified_user</span>
</div>
</div>
</div>
<div class="space-y-2 mb-8 text-center">
<p class="font-body-lg text-secondary text-[16px]">Vui lòng nhập mật khẩu hiện tại và mật khẩu mới để thay đổi.</p>
</div>
<!-- Form Fields -->
<form class="space-y-6" id="passwordForm" onsubmit="return false;">
<!-- Current Password -->
<div class="space-y-2">
<label class="font-label-md text-on-surface-variant block ml-1">Mật khẩu hiện tại</label>
<div class="relative password-input bg-surface-gray rounded-xl transition-all duration-200">
<input class="w-full h-12 bg-transparent border-none focus:ring-0 px-4 font-body-md text-on-surface placeholder-outline-variant" id="current_password" placeholder="••••••••" type="password">
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('current_password', this)" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
</div>
<!-- New Password -->
<div class="space-y-2">
<label class="font-label-md text-on-surface-variant block ml-1">Mật khẩu mới</label>
<div class="relative password-input bg-surface-gray rounded-xl transition-all duration-200 border-b-2 border-transparent">
<input class="w-full h-12 bg-transparent border-none focus:ring-0 px-4 font-body-md text-on-surface placeholder-outline-variant" id="new_password" placeholder="••••••••" type="password">
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('new_password', this)" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
<!-- Strength Indicator (Micro-interaction) -->
<div class="flex gap-1 mt-2 px-1">
<div class="h-1 flex-1 rounded-full bg-surface-container-highest transition-colors duration-300" id="strength-1"></div>
<div class="h-1 flex-1 rounded-full bg-surface-container-highest transition-colors duration-300" id="strength-2"></div>
<div class="h-1 flex-1 rounded-full bg-surface-container-highest transition-colors duration-300" id="strength-3"></div>
</div>
</div>
<!-- Confirm New Password -->
<div class="space-y-2">
<label class="font-label-md text-on-surface-variant block ml-1">Xác nhận mật khẩu mới</label>
<div class="relative password-input bg-surface-gray rounded-xl transition-all duration-200">
<input class="w-full h-12 bg-transparent border-none focus:ring-0 px-4 font-body-md text-on-surface placeholder-outline-variant" id="confirm_password" placeholder="••••••••" type="password">
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors" onclick="togglePassword('confirm_password', this)" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
<p class="text-error font-label-sm hidden px-1 pt-1" id="error-message">Mật khẩu xác nhận không khớp.</p>
</div>
<!-- Submit Button -->
<button class="w-full h-12 bg-primary text-white rounded-xl font-headline-sm text-[16px] font-bold shadow-md hover:bg-primary-container active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-8" onclick="handleSubmit()" type="submit">
                Cập nhật mật khẩu
                <span class="material-symbols-outlined text-[20px]">sync</span>
</button>
</form>
<!-- Security Message -->
<div class="mt-12 p-4 bg-surface-blue rounded-xl flex items-start gap-3">
<span class="material-symbols-outlined text-primary text-[24px]">shield</span>
<div>
<p class="font-label-md text-primary mb-1">Bảo mật tài khoản</p>
<p class="font-body-md text-on-surface-variant text-[13px]">Sử dụng mật khẩu mạnh bao gồm chữ cái, số và ký tự đặc biệt để bảo vệ tài khoản TravelPro của bạn.</p>
</div>
</div>
</main>
<!-- Success Toast (Hidden by default) -->
<div class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-on-background text-white px-6 py-3 rounded-full flex items-center gap-3 shadow-2xl transition-all duration-500 translate-y-20 opacity-0 pointer-events-none z-50" id="successToast">
<span class="material-symbols-outlined text-success">check_circle</span>
<span class="font-body-md">Mật khẩu đã được cập nhật</span>
</div>
<script>
        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                input.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        // Strength indicator logic
        const newPassInput = document.getElementById('new_password');
        newPassInput.addEventListener('input', function() {
            const val = this.value;
            const s1 = document.getElementById('strength-1');
            const s2 = document.getElementById('strength-2');
            const s3 = document.getElementById('strength-3');
            
            // Reset
            [s1, s2, s3].forEach(s => s.classList.replace('bg-warning', 'bg-surface-container-highest'));
            [s1, s2, s3].forEach(s => s.classList.replace('bg-success', 'bg-surface-container-highest'));
            [s1, s2, s3].forEach(s => s.classList.replace('bg-error', 'bg-surface-container-highest'));

            if (val.length > 0) {
                if (val.length < 6) {
                    s1.classList.replace('bg-surface-container-highest', 'bg-error');
                } else if (val.length < 10) {
                    s1.classList.replace('bg-surface-container-highest', 'bg-warning');
                    s2.classList.replace('bg-surface-container-highest', 'bg-warning');
                } else {
                    s1.classList.replace('bg-surface-container-highest', 'bg-success');
                    s2.classList.replace('bg-surface-container-highest', 'bg-success');
                    s3.classList.replace('bg-surface-container-highest', 'bg-success');
                }
            }
        });

        function handleSubmit() {
            const current = document.getElementById('current_password').value;
            const pass = document.getElementById('new_password').value;
            const confirm = document.getElementById('confirm_password').value;
            const errorMsg = document.getElementById('error-message');

            if (pass !== confirm) {
                errorMsg.classList.remove('hidden');
                return;
            } else {
                errorMsg.classList.add('hidden');
            }

            if (!current || !pass) {
                alert('Vui lòng điền đầy đủ thông tin');
                return;
            }

            // Simulate loading state
            const btn = event.currentTarget;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="animate-spin material-symbols-outlined">progress_activity</span> Đang xử lý...`;

            setTimeout(() => {
                const toast = document.getElementById('successToast');
                toast.classList.remove('translate-y-20', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
                
                setTimeout(() => {
                    window.location.reload();
                }, 2000);
            }, 1500);
        }
    </script>
</body></html>