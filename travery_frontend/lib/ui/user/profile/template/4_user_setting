<!DOCTYPE html><html class="light" lang="vi"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<style>
        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .toggle-checkbox:checked + .toggle-slot {
            background-color: #0052cc;
        }
        .toggle-checkbox:checked + .toggle-slot .toggle-dot {
            transform: translateX(20px);
        }
        .safe-area-bottom {
            padding-bottom: env(safe-area-inset-bottom);
        }
    </style>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "text-dark": "#172B4D",
                    "secondary-fixed": "#e2e2e2",
                    "on-tertiary-fixed-variant": "#812800",
                    "surface-container": "#e7eeff",
                    "on-background": "#101c2d",
                    "outline": "#737685",
                    "warning": "#FFAB00",
                    "surface-container-low": "#f0f3ff",
                    "secondary": "#5d5f5f",
                    "outline-variant": "#c3c6d6",
                    "inverse-on-surface": "#ebf1ff",
                    "on-secondary-fixed": "#1a1c1c",
                    "inverse-primary": "#b2c5ff",
                    "tertiary": "#7b2600",
                    "secondary-fixed-dim": "#c6c6c7",
                    "error-container": "#ffdad6",
                    "background": "#f9f9ff",
                    "inverse-surface": "#253143",
                    "surface-variant": "#d7e3fb",
                    "on-surface-variant": "#434654",
                    "surface-container-highest": "#d7e3fb",
                    "on-tertiary-fixed": "#380d00",
                    "error": "#FF5630",
                    "on-secondary-container": "#616363",
                    "tertiary-fixed-dim": "#ffb59b",
                    "surface-dim": "#cedbf2",
                    "tertiary-container": "#a33500",
                    "primary-fixed": "#dae2ff",
                    "on-primary-container": "#c4d2ff",
                    "surface-container-lowest": "#ffffff",
                    "on-primary": "#ffffff",
                    "surface-bright": "#f9f9ff",
                    "on-tertiary-container": "#ffc6b2",
                    "surface-tint": "#0c56d0",
                    "on-secondary-fixed-variant": "#454747",
                    "on-error": "#ffffff",
                    "on-tertiary": "#ffffff",
                    "primary": "#003d9b",
                    "on-surface": "#101c2d",
                    "on-secondary": "#ffffff",
                    "primary-container": "#0052cc",
                    "tertiary-fixed": "#ffdbcf",
                    "surface-gray": "#F4F5F7",
                    "surface-container-high": "#dee9ff",
                    "on-primary-fixed": "#001848",
                    "secondary-container": "#dfe0e0",
                    "surface-blue": "#F4F7FF",
                    "surface": "#f9f9ff",
                    "on-primary-fixed-variant": "#0040a2",
                    "primary-fixed-dim": "#b2c5ff",
                    "success": "#36B37E",
                    "on-error-container": "#93000a"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "container-padding": "20px",
                    "xs": "4px",
                    "base": "8px",
                    "sm": "8px",
                    "md": "16px",
                    "lg": "24px",
                    "xl": "32px",
                    "gutter": "12px"
            },
            "fontFamily": {
                    "headline-md": ["Inter"],
                    "label-md": ["Inter"],
                    "display-lg": ["Inter"],
                    "headline-sm": ["Inter"],
                    "body-lg": ["Inter"],
                    "body-md": ["Inter"],
                    "label-sm": ["Inter"]
            },
            "fontSize": {
                    "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                    "display-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "headline-sm-mobile": ["18px", {"lineHeight": "24px", "fontWeight": "600"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}]
            }
          },
        },
      }
